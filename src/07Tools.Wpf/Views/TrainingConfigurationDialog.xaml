<Window x:Class="RunescapeTools.Wpf.Views.TrainingConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520"
        SizeToContent="Height"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource SectionTitle}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Method, StringFormat=Current method: {0}}"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,5,0,18" />

        <ScrollViewer Grid.Row="2" MaxHeight="480">
            <Grid>
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}"
                                    Padding="14"
                                    Margin="0,0,0,10"
                                    IsEnabled="{Binding IsApplicable}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding ToggleValue}"
                                              FontWeight="SemiBold">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToggle}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,7" />
                                        <ComboBox ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedChoice}"
                                                  DisplayMemberPath="DisplayName"
                                                  Padding="8,5">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="IsEnabled"
                                                            Value="{Binding IsEnabled}" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNumber}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,7" />
                                        <TextBox Text="{Binding NumberValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,5" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding ValidationMessage}"
                                               Foreground="{StaticResource NegativeBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding AvailabilityMessage}"
                                               Foreground="{StaticResource GoldDarkBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Notice}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOptions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No configuration options are available yet. This skill is ready for future settings."
                               Foreground="{StaticResource MutedBrush}" />
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Reset defaults"
                    Command="{Binding ResetDefaultsCommand}"
                    Style="{StaticResource TextButton}"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Grid.Column="2"
                    Content="Apply"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsValid}"
                    IsDefault="True"
                    Click="Apply_Click" />
        </Grid>
    </Grid>
</Window>
