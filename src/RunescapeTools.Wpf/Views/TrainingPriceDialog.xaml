<Window x:Class="RunescapeTools.Wpf.Views.TrainingPriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="840"
        Height="650"
        MinWidth="720"
        MinHeight="440"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource SectionTitle}"
                       FontSize="23" />
            <TextBlock Text="{Binding Method, StringFormat=Selected route: {0}}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       Margin="0,5,0,0" />
            <TextBlock Text="{Binding GoalSummary}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       Margin="0,3,0,0" />
            <TextBlock Text="{Binding RouteSummary, StringFormat=Calculated route: {0}}"
                       Foreground="{StaticResource GoldDarkBrush}"
                       FontSize="12"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Style="{StaticResource Panel}"
                    Padding="14"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="ESTIMATED NET GP"
                               Style="{StaticResource Kicker}"
                               FontSize="10" />
                    <TextBlock Text="{Binding EstimatedNetGp}"
                               FontFamily="Georgia"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Style="{StaticResource Panel}"
                    Padding="14"
                    Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="ECONOMIC COVERAGE"
                               Style="{StaticResource Kicker}"
                               FontSize="10" />
                    <TextBlock Text="{Binding PricingStatus}"
                               FontFamily="Georgia"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Background="#E8DECA" Height="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="155" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ACTION" Margin="12,0" VerticalAlignment="Center"
                       Style="{StaticResource Kicker}" FontSize="10" />
            <TextBlock Grid.Column="1" Text="ITEM" VerticalAlignment="Center"
                       Style="{StaticResource Kicker}" FontSize="10" />
            <TextBlock Grid.Column="2" Text="GOAL QUANTITY" VerticalAlignment="Center"
                       Style="{StaticResource Kicker}" FontSize="10" />
            <TextBlock Grid.Column="3" Text="SUGGESTED UNIT PRICE" VerticalAlignment="Center"
                       Style="{StaticResource Kicker}" FontSize="10" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="66" Background="#FCFAF4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="4"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1" />
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Action}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="12,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NegativeBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutput}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource PositiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ItemNumber}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="{Binding Quantity}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding QuantityCaption}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="{Binding UnitPrice}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding QuoteDetail}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border VerticalAlignment="Top"
                    Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Notice}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="No live Grand Exchange ingredients or outputs are defined for the calculated route."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Inputs use the latest high price; outputs use the latest low price. Quantities cover the complete calculated route to your current goal. Recent completed trades do not guarantee offer execution."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0" />
            <Button Grid.Column="1"
                    Content="Close"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
